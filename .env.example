# AppReviewr local configuration
# Copy to .env and adjust as needed.

# Backend
APPREVIEW_ENVIRONMENT=development
APPREVIEW_DEBUG=false
APPREVIEW_HOST=0.0.0.0
APPREVIEW_PORT=8741
APPREVIEW_CORS_ORIGINS=http://localhost:3741,http://127.0.0.1:3741
APPREVIEW_DATABASE_URL=sqlite+aiosqlite:///./data/appreviewr.db
APPREVIEW_CACHE_TTL_HOURS=12
APPREVIEW_MAX_REVIEWS_PER_JOB=2000
APPREVIEW_MAX_COUNTRIES_PER_JOB=10
APPREVIEW_RATE_LIMIT_PER_IP=30/minute
APPREVIEW_JOB_RATE_LIMIT_PER_IP=10/hour
APPREVIEW_HTTP_TIMEOUT_SECONDS=30
APPREVIEW_HTTP_MAX_RETRIES=3

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8741
NEXT_PUBLIC_SITE_URL=https://appreviewr.local
PORT=3741

# App Store waitlist — paste your Google Form "viewform" (or embed) URL.
# Create a Form at https://forms.google.com → Send → Copy link → paste here.
# Example: https://docs.google.com/forms/d/e/XXXX/viewform
# Leave empty until you have a Form; the waitlist page will show a setup hint.
NEXT_PUBLIC_APP_STORE_WAITLIST_FORM_URL=
