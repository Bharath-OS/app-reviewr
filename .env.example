# AppReviewr local configuration
# Copy to .env and adjust as needed.

# Backend
APPREVIEW_ENVIRONMENT=development
APPREVIEW_DEBUG=false
APPREVIEW_HOST=0.0.0.0
APPREVIEW_PORT=8741
APPREVIEW_CORS_ORIGINS=http://localhost:3741,http://127.0.0.1:3741
APPREVIEW_DATABASE_URL=sqlite+aiosqlite:///./data/appreviewr.db
APPREVIEW_CACHE_TTL_HOURS=12
APPREVIEW_MAX_REVIEWS_PER_JOB=2000
APPREVIEW_MAX_COUNTRIES_PER_JOB=10
APPREVIEW_RATE_LIMIT_PER_IP=30/minute
APPREVIEW_JOB_RATE_LIMIT_PER_IP=10/hour
APPREVIEW_HTTP_TIMEOUT_SECONDS=30
APPREVIEW_HTTP_MAX_RETRIES=3

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8741
NEXT_PUBLIC_SITE_URL=https://appreviewr.local
PORT=3741

# App Store waitlist → Google Form / linked Sheet (no app database).
# Create a Form (Name, Email, optional Message) at https://forms.google.com
# ACTION URL must be the formResponse endpoint (not viewform):
#   https://docs.google.com/forms/d/e/FORM_ID/formResponse
# Entry IDs: open the live form → right-click a field → Inspect, or use
# "Get pre-filled link" and copy entry.XXXXXXXX from the URL.
NEXT_PUBLIC_GOOGLE_FORM_ACTION_URL=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_NAME=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY_EMAIL=
# Optional — only set if your Form has a Message / notes question:
# NEXT_PUBLIC_GOOGLE_FORM_ENTRY_MESSAGE=
